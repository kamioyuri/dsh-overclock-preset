{
  "name": "dsh-overclock-preset",
  "version": "1.0.0",
  "private": true,
  "description": "超频模式 / Overclock Mode —— dsh agent 预设：不限预算的完整输出 + 默认多 agent 并行分工与汇总。An agent preset for DeepSeek Harness: untruncated output plus automatic multi-agent fan-out.",
  "type": "module",
  "license": "MIT",
  "author": "kamioyuri",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./preset": "./lib/preset.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "test": "node --test tests/preset.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamioyuri/dsh-overclock-preset.git"
  },
  "homepage": "https://github.com/kamioyuri/dsh-overclock-preset#readme",
  "bugs": {
    "url": "https://github.com/kamioyuri/dsh-overclock-preset/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "agent-preset",
    "overclock",
    "multi-agent"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshx": {
    "permissions": "只调用宿主的预设注册表服务注册一个 agent 预设；不读写用户文件、不联网、不注册工具。Registers one agent preset through the host registry; no file access, no network, no tools."
  }
}
